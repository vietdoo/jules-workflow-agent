# Required credentials
TELEGRAM_BOT_TOKEN=replace-with-token-from-botfather
JULES_API_KEY=replace-with-api-key-from-jules-settings

# Jules API. The default is the official Jules v1alpha REST API.
JULES_API_URL=https://jules.googleapis.com/v1alpha

# Deployment mode. Leave WEBHOOK_URL empty for local long polling.
# For Render, set this to the service's public HTTPS URL, for example:
# WEBHOOK_URL=https://my-telegram-bot.onrender.com
WEBHOOK_URL=
PORT=8080
WEBHOOK_SECRET_TOKEN=

# Optional Jules request and polling tuning.
JULES_TIMEOUT_SECONDS=60
JULES_POLL_INTERVAL_SECONDS=2
JULES_REPLY_TIMEOUT_SECONDS=120
LOG_LEVEL=INFO

# Optional repository context for new Jules sessions.
# Example: sources/github/your-github-user/your-repository
JULES_SOURCE=
JULES_STARTING_BRANCH=main
# When true, the bot exposes an approval button before Jules executes a plan.
JULES_REQUIRE_PLAN_APPROVAL=false
# Optional values supported by the Jules API, such as AUTO_CREATE_PR.
JULES_AUTOMATION_MODE=

# Agent harness. Keep `jules` until another adapter is registered in the application.
AGENT_DEFAULT_ID=jules

# Local control plane and Next.js studio.
WEB_API_HOST=127.0.0.1
WEB_API_PORT=8090
WEB_CORS_ORIGINS=http://localhost:3000
LOCAL_DATA_DIR=runtime
